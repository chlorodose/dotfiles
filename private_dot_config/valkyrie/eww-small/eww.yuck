;; Physical display: the small screen is mounted on the AIO water-cooling head.
(include "../telemetry.yuck")
(include "../fan-map.yuck")
(defwindow small :monitor 0
 :geometry (geometry :width "320px" :height "240px" :anchor "top left")
 :wm-ignore false :windowtype "normal" :stacking "fg"
 (box :orientation "v" :class "cooler ${stats.cpu_class}" :space-evenly false :spacing 5
  (box :space-evenly false
   (label :class "eyebrow" :text "CPU · 9950X3D" :xalign 0 :hexpand true)
   (label :class "live ${stats.cpu_class}" :text {stats.cpu_class == "ok" ? "● LIVE" : stats.cpu_class == "hot" ? "● HIGH" : "● WARN"}))
  (box :space-evenly false :valign "center"
   (label :class "temperature ${stats.cpu_temp_class}" :text {stats.cpu_temp} :xalign 0 :hexpand true)
   (box :orientation "v" :space-evenly false :spacing 3 :valign "center"
    (label :class "muted" :text "PACKAGE / °C" :xalign 1)
    (label :class "frequency" :text {stats.cpu_ghz} :xalign 1)))
  (box :space-evenly false
   (label :class "muted" :text "CPU LOAD" :xalign 0 :hexpand true)
   (label :class "load-value ${stats.cpu_load_class}" :text {stats.cpu_load}))
  (progress :class "cpu-bar ${stats.cpu_load_class}" :value {stats.cpu_pct})
  (box :class "cooling" :space-evenly true :spacing 8
   (box :orientation "v" :space-evenly false :spacing 3
    (label :class "muted" :text "CPU FAN / RPM" :xalign 0)
    (label :class "rpm" :text {stats.fans[cpu_fan_channel]} :xalign 0))
   (box :orientation "v" :space-evenly false :spacing 3
    (label :class "muted" :text "PUMP / RPM" :xalign 0)
    (label :class "rpm" :text {stats.fans[pump_channel]} :xalign 0)))
  (label :class "sensor-note ${stats.cpu_class}" :text {stats.cpu_class == "ok" ? "CPU RADIATOR + AIO PUMP" : stats.cpu_status} :xalign 0)))
