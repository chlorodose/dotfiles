[Unit]
Description=Valkyrie LCDs — one Weston and two Eww dashboards
After=graphical-session.target
PartOf=graphical-session.target
StartLimitIntervalSec=0

[Service]
Type=exec
ExecStart=%h/.config/valkyrie/valkyrie-weston
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=10
Slice=session-graphical.slice

[Install]
WantedBy=graphical-session.target
