#!/usr/bin/env bash
set -euo pipefail

if [ ! -e /run/.toolboxenv ]; then
    exec toolbox run -- "$0" "$@"
fi

if [ -e /usr/share/toolbox-inited ]; then
    exit 0
fi
_on_exit() {
  [ "$?" = "0" ] && sudo install -m 0644 /dev/null /usr/share/toolbox-inited || true
}
trap '_on_exit' EXIT

mkdir -p "$HOME"/.cache/dnf
sudo dnf config-manager setopt "cachedir=$HOME/.cache/dnf" "system_cachedir=$HOME/.cache/dnf"

sudo dnf --repofrompath "vscode,https://packages.microsoft.com/yumrepos/vscode" --nogpgcheck install -y code

[ -e "$HOME/Projects/codex-desktop-linux" ] && make -C "$HOME/Projects/codex-desktop-linux" install

echo 'Toolbox initialization complete.' >&2
